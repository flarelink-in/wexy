  "modules": [
    {
      "module": "placeOrbs",
      "interfaceHash": "5a9c7ec585625e5cdb2574ea6af29b8bead4fd121ee55cbfcaa622ca5a23be32",
      "codeHash": "06afe9d9226e22d7c86e0222afcb3969f90f0048dc05a942e303f51b52eb2c6f",
      "body": "fn placeOrbs(index: u32) {\n    let base = index * B_orbs_STRIDE;\n    let col = f32(index % 3u);\n    let row = f32(index / 3u);\n    let half = f32(2u) * 0.5;\n    b_orbs[base + 0u] = 0.0;\n    b_orbs[base + 1u] = (col - half) * 3;\n    b_orbs[base + 2u] = 0.0;\n    b_orbs[base + 3u] = (row - half) * 3;\n    b_orbs[base + 4u] = 0.0;\n    b_orbs[base + 5u] = 0.0;\n    b_orbs[base + 6u] = 0.0;\n    b_orbs[base + 7u] = 1.0;\n    b_orbs[base + 8u] = 1;\n    b_orbs[base + 9u] = 1;\n    b_orbs[base + 10u] = 1;\n    b_orbs[base + 11u] = 0.55 + 0.4 * fract(col * 0.37);\n    b_orbs[base + 12u] = 0.55 + 0.4 * fract(row * 0.29);\n    b_orbs[base + 13u] = 0.7;\n}"
    }
