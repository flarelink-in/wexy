  "modules": [
    {
      "module": "placeCells",
      "interfaceHash": "d20fd09b5454b6f18ea18f92675f28cde15520f973b6ff957597a61ee18de6fd",
      "codeHash": "36d7dfae67bab34f03e290f2d35bca6438008bb0f65f5168ec81682d060ac958",
      "body": "fn placeCells(index: u32) {\n    let base = index * B_cells_STRIDE;\n    let col = f32(index % 4u);\n    let row = f32(index / 4u);\n    let half = f32(3u) * 0.5;\n    b_cells[base + 0u] = 0.0;\n    b_cells[base + 1u] = (col - half) * 2.5;\n    b_cells[base + 2u] = 0.0;\n    b_cells[base + 3u] = (row - half) * 2.5;\n    b_cells[base + 4u] = 0.0;\n    b_cells[base + 5u] = 0.0;\n    b_cells[base + 6u] = 0.0;\n    b_cells[base + 7u] = 1.0;\n    b_cells[base + 8u] = 1;\n    b_cells[base + 9u] = 1;\n    b_cells[base + 10u] = 1;\n    b_cells[base + 11u] = 0.55 + 0.4 * fract(col * 0.37);\n    b_cells[base + 12u] = 0.55 + 0.4 * fract(row * 0.29);\n    b_cells[base + 13u] = 0.7;\n}"
    }
  ]
