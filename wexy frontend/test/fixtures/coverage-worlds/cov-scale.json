  "modules": [
    {
      "module": "seedSwarm",
      "interfaceHash": "18cd1c82556a3c7297d22ec6c0cf3fec458ddddaf04dbcf0ea7f172cdb118d1a",
      "codeHash": "1a387aabb05226269a6f0280aa67bac8ad858af67198ad9532ba3f220363b228",
      "body": "fn seedSwarm(index: u32) {\n    let base = index * B_swarm_STRIDE;\n    let col = f32(index % 512u);\n    let row = f32(index / 512u);\n    let half = f32(511u) * 0.5;\n    b_swarm[base + 0u] = 0.0;\n    b_swarm[base + 1u] = (col - half) * 0.05859375;\n    b_swarm[base + 2u] = 0.0;\n    b_swarm[base + 3u] = (row - half) * 0.05859375;\n    b_swarm[base + 4u] = 0.0;\n    b_swarm[base + 5u] = 0.0;\n    b_swarm[base + 6u] = 0.0;\n    b_swarm[base + 7u] = 1.0;\n    b_swarm[base + 8u] = 1;\n    b_swarm[base + 9u] = 1;\n    b_swarm[base + 10u] = 1;\n    b_swarm[base + 11u] = 0.55 + 0.4 * fract(col * 0.37);\n    b_swarm[base + 12u] = 0.55 + 0.4 * fract(row * 0.29);\n    b_swarm[base + 13u] = 0.7;\n}"
    },
    {
      "module": "turnSwarm",
      "interfaceHash": "59f4a1020359c61dfaa3ff9417a8e7d83c44c7d4b4baf69ae3a16be70d1fda72",
      "codeHash": "a7ebae0249efd9fcdc848de527c09734a81615bc4f658d14a7d95f2f7f581068",
      "body": "fn turnSwarm(index: u32) {\n    let base = index * B_swarm_STRIDE;\n    let half = 0.5 * (sim.time + f32(index % 97u) * 0.1);\n    b_swarm[base + 4u] = 0.0;\n    b_swarm[base + 5u] = sin(half);\n    b_swarm[base + 6u] = 0.0;\n    b_swarm[base + 7u] = cos(half);\n}"
    }
  ]
}
