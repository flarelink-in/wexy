{
  "hosting": [
    {
      "target": "dev",
      "public": "hosting-dev",
      "predeploy": ["node scripts/prepare-hosting.mjs dev --check"],
      "redirects": [{ "source": "/index.html", "destination": "/", "type": 301 }],
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/studio",
          "destination": "/studio.html"
        },
        {
          "regex": "^/(|robots[.]txt|sitemap[.]xml)$",
          "function": {
            "functionId": "renderPublicDev",
            "region": "us-central1",
            "pinTag": true
          }
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
            { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=()" },
            { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "/showcase/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=86400" }
          ]
        },
        {
          "source": "/favicon.svg",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=86400" }
          ]
        }
      ]
    },
    {
      "target": "prod",
      "public": "hosting-prod",
      "predeploy": ["node scripts/prepare-hosting.mjs prod --check"],
      "redirects": [{ "source": "/index.html", "destination": "/", "type": 301 }],
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        { "source": "/studio", "destination": "/studio.html" },
        { "regex": "^/(|robots[.]txt|sitemap[.]xml)$", "function": { "functionId": "renderPublicProd", "region": "us-central1", "pinTag": true } }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
            { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=()" }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "/showcase/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=86400" }
          ]
        },
        {
          "source": "/favicon.svg",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=86400" }
          ]
        }
      ]
    }
  ],
  "functions": [{
    "source": "functions",
    "codebase": "public-html",
    "runtime": "nodejs22",
    "ignore": ["node_modules", ".git", "*.log", ".env", ".env.*"],
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run check"]
  }],
  "emulators": {
    "functions": { "port": 5001 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true },
    "singleProjectMode": true
  }
}
