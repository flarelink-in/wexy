# Public configuration for the browser (coding principles §11). Every value here ends up in the
# bundle, readable by anyone: no secret ever belongs in this file. The Meta API key and the Firebase
# service account live in the backend. The values live in Infisical (decided 2026-10-27) and reach
# Vite as environment variables: `infisical run --env=dev -- npm run dev` (docs/dev-workflow.md §2).
# A git-ignored .env.local also works; Infisical's values win over it.

# The gateway's origin, with no trailing slash. Locally, the backend's gateway (profile local).
VITE_API_ORIGIN=http://localhost:8400

# Wexy's Firebase web app, in project wexy-bf8f8: Project settings > Your apps > Web app, or
#   firebase apps:sdkconfig WEB <app-id> --project wexy-bf8f8
# Leave VITE_FIREBASE_API_KEY empty to run without Firebase. A development build then calls a
# loopback gateway with the backend's local dev identity (its Q22, accepted 2026-10-27), and nothing
# else. Firebase on both sides or on neither: docs/dev-workflow.md §3.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=wexy-bf8f8.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=wexy-bf8f8
VITE_FIREBASE_APP_ID=

# App Check: the reCAPTCHA Enterprise site key registered for the web app. Empty: no App Check
# token is sent, which the gateway's local profile does not ask for.
VITE_APPCHECK_SITE_KEY=
