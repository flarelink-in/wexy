<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		FlareLink's exact Spring Boot, Spring Cloud and Java versions, so code copied from it compiles
		unchanged (backend architecture §4). They are past open-source support; upgrading waits until
		after the hackathon (plan §5).
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.4</version>
		<relativePath/>
	</parent>

	<groupId>ai.wexy</groupId>
	<artifactId>wexy-backend</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>wexy-backend</name>
	<description>Wexy's server half: forge-gateway, forge-service and (since W2) platform-service.</description>

	<modules>
		<module>forge-common</module>
		<module>forge-gateway</module>
		<module>forge-service</module>
		<module>platform-service</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<spring-cloud.version>2023.0.0</spring-cloud.version>
		<firebase-admin.version>9.2.0</firebase-admin.version>
		<nimbus-jose-jwt.version>10.9.1</nimbus-jose-jwt.version>
		<!-- Q27. The 1.5 line is the last on Jackson 2; Spring Boot 3.2 manages Jackson 2.15. -->
		<json-schema-validator.version>1.5.9</json-schema-validator.version>
		<!--
			Over Spring Boot 3.2.4's 1.19.7, which asks Docker for API 1.32: Docker Engine 29 (29.7.2 on
			this laptop) serves 1.40 and newer only, so every Testcontainers call answered 400 and the strict
			gate failed with Docker running (gotchas, 2026-10-27). 1.21.4 is the last 1.x and works with 29.
		-->
		<testcontainers.version>1.21.4</testcontainers.version>
		<!--
			W3 (the creations platform design §3, §8): the S3 client pointed at B2. v2, since v1 reached end of support
			[S1]; at least 2.30, which brought the checksum settings B2 needs set to WHEN_REQUIRED [S14]. 2.57.0, released
			2026-10-19.
		-->
		<awssdk.version>2.57.0</awssdk.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>ai.wexy</groupId>
				<artifactId>forge-common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.google.firebase</groupId>
				<artifactId>firebase-admin</artifactId>
				<version>${firebase-admin.version}</version>
			</dependency>
			<dependency>
				<groupId>com.nimbusds</groupId>
				<artifactId>nimbus-jose-jwt</artifactId>
				<version>${nimbus-jose-jwt.version}</version>
			</dependency>
			<dependency>
				<groupId>com.networknt</groupId>
				<artifactId>json-schema-validator</artifactId>
				<version>${json-schema-validator.version}</version>
			</dependency>
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>bom</artifactId>
				<version>${awssdk.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<profiles>
		<!-- Release/CI gate: unlike the offline-friendly default, missing Docker must fail. -->
		<profile>
			<id>redis-tests</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<systemPropertyVariables>
								<wexy.require-docker>true</wexy.require-docker>
							</systemPropertyVariables>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
