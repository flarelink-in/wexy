# Whitespace only; the code style is in docs/coding-principles.md §12.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json}]
indent_size = 2

# Spring Initializr writes pom.xml with tabs, as FlareLink's are.
[pom.xml]
indent_style = tab

[*.{cmd,bat}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
