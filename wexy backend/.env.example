# The names the services read. Their values live in Infisical and reach a process through
# `infisical run --env=<env> -- <command>`, locally as in deploys (decided 2026-10-27, Q29), so no
# file holds a key. (The local profile still imports a git-ignored .env if one exists, as KEY=value
# lines; keys are not kept there.) Never commit a filled-in copy.

# --- forge-service ---
# The Meta Model API key. It never reaches a browser, a log or a report.
WEXY_META_API_KEY=
# OpenAI-compatible base URL (backend architecture §6.1). Change only if the console says otherwise.
WEXY_META_API_BASE_URL=https://api.meta.ai/v1
# Where the service fetches the gateway's public key set.
WEXY_GATEWAY_URL=http://localhost:8400

# --- forge-gateway ---
# Base64 PKCS#8 RSA key shared by every gateway instance. Empty locally: an ephemeral key is made.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
WEXY_INTERNAL_JWT_PRIVATE_KEY=
# Base64 of Wexy's own Firebase service account JSON. Empty locally (the local profile turns sign-in off).
FIREBASE_SERVICE_ACCOUNT_B64=
WEXY_APPCHECK_PROJECT_NUMBER=
WEXY_APPCHECK_ALLOWED_APP_IDS=
WEXY_ADMIN_UIDS=
WEXY_FORGE_SERVICE_URL=http://localhost:8410

# --- both ---
REDIS_HOST=localhost
REDIS_PORT=6390
