{
  "title": "Wexy edit plan, v1",
  "description": "The director's answer to one instruction about a running world.",
  "type": "object",
  "additionalProperties": false,
  "required": ["edit"],
  "properties": {
    "edit": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ops", "summary"],
          "properties": {
            "kind": { "type": "string", "const": "patch" },
            "ops": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/op" } },
            "summary": { "$ref": "#/$defs/summary" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "functions", "instruction", "ops", "summary"],
          "properties": {
            "kind": { "type": "string", "const": "rewrite" },
            "functions": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "enum": ["evolve", "look", "sky"] } },
            "instruction": { "type": "string", "minLength": 1, "maxLength": 400, "description": "What the rewritten functions must do differently." },
            "ops": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/op" } },
            "summary": { "$ref": "#/$defs/summary" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "prompt"],
          "properties": {
            "kind": { "type": "string", "const": "restart" },
            "prompt": { "type": "string", "minLength": 1, "maxLength": 600, "description": "The idea for the new world." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "question"],
          "properties": {
            "kind": { "type": "string", "const": "clarify" },
            "question": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        }
      ]
    }
  },
  "$defs": {
    "op": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "value"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 80, "description": "uniforms.<name>, post.<block>.<field>, camera.move, or camera.keyframes.<n>.<field>." },
        "value": { "anyOf": [ { "type": "number" }, { "type": "string", "maxLength": 40 }, { "type": "boolean" }, { "$ref": "#/$defs/vec3" } ] }
      }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 200, "description": "One sentence for the creator: what changed." },
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
  }
}
