{
  "title": "Wexy scene draft, v1",
  "description": "The planner's answer: a particle world's data, without its code. Every property is required; a block a world does not use is null.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "summary", "style", "particles", "arrangement", "light", "sky", "uniforms", "camera", "post"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 60, "description": "The world's name, a few words." },
    "summary": { "type": "string", "minLength": 1, "maxLength": 200, "description": "One sentence: what the world is and how it moves." },
    "style": { "type": "string", "enum": ["cinematic", "anime-cel", "cosmic", "brutalist"] },
    "particles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "dt", "warmupSeconds", "seed", "spawn"],
      "properties": {
        "count": { "type": "integer", "minimum": 65536, "maximum": 2097152 },
        "dt": { "type": "number", "minimum": 0.004, "maximum": 0.05, "description": "Seconds per step: 0.0166667." },
        "warmupSeconds": { "type": "number", "minimum": 0, "maximum": 10 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "spawn": {
          "type": "object",
          "additionalProperties": false,
          "required": ["phase", "x", "y", "z", "w"],
          "properties": {
            "phase": { "type": "string", "enum": ["zero", "random-angle"] },
            "x": { "$ref": "#/$defs/distribution" },
            "y": { "$ref": "#/$defs/distribution" },
            "z": { "$ref": "#/$defs/distribution" },
            "w": { "$ref": "#/$defs/distribution" }
          }
        }
      }
    },
    "arrangement": { "type": "null", "description": "Geometry worlds come later: always null in v1." },
    "light": { "type": "null", "description": "Geometry worlds come later: always null in v1." },
    "sky": { "type": "string", "enum": ["function", "black"] },
    "uniforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "label", "value", "min", "max", "step"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,23}$", "description": "camelCase, a valid WGSL field name; never quality." },
          "label": { "type": "string", "minLength": 1, "maxLength": 32 },
          "value": { "type": "number" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "step": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyframes", "move"],
      "properties": {
        "keyframes": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/keyframe" } },
        "move": { "anyOf": [ { "type": "string", "enum": ["orbit", "dolly-in", "flyby", "crane"] }, { "type": "null" } ] }
      }
    },
    "post": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bloom", "halation", "tonemap", "fxaa", "vignette"],
      "properties": {
        "bloom": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["threshold", "intensity"],
              "properties": {
                "threshold": { "type": "number", "minimum": 0, "maximum": 4 },
                "intensity": { "type": "number", "minimum": 0, "maximum": 3 }
              }
            },
            { "type": "null" }
          ]
        },
        "halation": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["threshold", "intensity", "radius", "tint"],
              "properties": {
                "threshold": { "type": "number", "minimum": 0, "maximum": 4 },
                "intensity": { "type": "number", "minimum": 0, "maximum": 2 },
                "radius": { "type": "number", "minimum": 0, "maximum": 8 },
                "tint": { "$ref": "#/$defs/vec3" }
              }
            },
            { "type": "null" }
          ]
        },
        "tonemap": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["curve", "exposure"],
              "properties": {
                "curve": { "type": "string", "enum": ["aces", "agx", "reinhard"] },
                "exposure": { "type": "number", "minimum": 0.1, "maximum": 4 }
              }
            },
            { "type": "null" }
          ]
        },
        "fxaa": { "type": "boolean" },
        "vignette": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["intensity", "softness"],
              "properties": {
                "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
                "softness": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            },
            { "type": "null" }
          ]
        }
      }
    }
  },
  "$defs": {
    "distribution": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["dist", "min", "max", "use"],
          "properties": {
            "dist": { "type": "string", "const": "uniform" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "use": { "$ref": "#/$defs/use" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["dist", "min", "max", "power", "use"],
          "properties": {
            "dist": { "type": "string", "const": "power" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "power": { "type": "number", "minimum": 0.1, "maximum": 8 },
            "use": { "$ref": "#/$defs/use" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["dist", "min", "max", "use"],
          "properties": {
            "dist": { "type": "string", "const": "triangular" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "use": { "$ref": "#/$defs/use" }
          }
        }
      ]
    },
    "use": { "type": "string", "minLength": 1, "maxLength": 80, "description": "What the code should use this number for." },
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "target", "distance", "azimuth", "polar", "fov"],
      "properties": {
        "t": { "type": "number", "minimum": 0, "maximum": 1, "description": "Time in the film, 0 to 1." },
        "target": { "$ref": "#/$defs/vec3" },
        "distance": { "type": "number", "minimum": 1, "maximum": 200 },
        "azimuth": { "type": "number", "minimum": -360, "maximum": 360, "description": "Degrees." },
        "polar": { "type": "number", "minimum": 1, "maximum": 179, "description": "Degrees from +y." },
        "fov": { "type": "number", "minimum": 15, "maximum": 100, "description": "Vertical, degrees." }
      }
    }
  }
}
