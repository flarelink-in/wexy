{
  "kind": "propose_design_and_program",
  "context": null,
  "design": {
    "intent": "Rolling grass hills receding to a far ridge at dusk under thick valley fog, with the last warm light fading behind the ridge and a dusky gradient sky above.",
    "interpretation": "Read as ground-level view across layered hills toward western ridge sunset; sun occluded by ridge leaving rim glow; fog is height fog pooled in valleys obscuring far hills.",
    "assumptions": [
      "Terrain is procedural CPU geometry, no assets or downloads.",
      "Dusk sun is low behind far ridge, mostly occluded.",
      "Thick fog is HeightFog single-scatter, no samplable depth.",
      "One global IBL environment is enough for open hills.",
      "Camera stays low over valley, no interior or water."
    ],
    "visualElements": [
      {
        "description": "128x128 displaced plane ~200x200 units, layered sine hills 4-10 units high, smooth normals",
        "name": "rolling terrain"
      },
      {
        "description": "Far ridge silhouette 60 units wide at -Z, occludes sun disc lower half",
        "name": "sunset ridge"
      },
      {
        "description": "GradientSky zenith dusky blue, horizon warm orange-pink, low sun disc intensity 8",
        "name": "dusk sky"
      },
      {
        "description": "Height fog referenceHeight 0, scaleHeight 0.25km, bluish-grey scattering, valleys opaque",
        "name": "thick valley fog"
      }
    ],
    "motion": "Static hills; slow camera drift; fog density constant with slight sun intensity falloff over loop to sell fading light; no characters, water, or clouds.",
    "animated": false,
    "techniques": [
      {
        "docIds": [
          "api/geometry",
          "agent/guide"
        ],
        "purpose": "Procedural rolling-hill terrain mesh baked on CPU into StandardLayout buffers",
        "symbols": [
          "geometry:GeometryBuilder",
          "core:NullGraph"
        ]
      },
      {
        "docIds": [
          "api/materials",
          "api/lights"
        ],
        "purpose": "Cheap lit diffuse hills with half-lambert plus direct lights",
        "symbols": [
          "materials:LambertMaterial",
          "lights:LightSystem"
        ]
      },
      {
        "docIds": [
          "api/environment"
        ],
        "purpose": "Dusk gradient sky with sun disc driving IBL diffuse and specular",
        "symbols": [
          "environment:EnvironmentSystem"
        ]
      },
      {
        "docIds": [
          "api/aerial-perspective"
        ],
        "purpose": "Thick valley height fog injected into Lambert without samplable depth",
        "symbols": [
          "environment:HeightFog"
        ]
      }
    ],
    "resourceFlow": [
      "GeometryBuilder bakes hill vertices -> vertex/index buffers -> terrain batch",
      "Instance record positions terrain at origin -> Lambert vertex shader",
      "LightSystem directional+hemisphere -> group 2 direct light",
      "EnvironmentSystem GradientSky -> prefiltered cube+SH -> group 2 indirect",
      "HeightFog params -> group 2 bindings 18-19 -> fogged Lambert fragment",
      "Scene pass draws hills, sky pass fills background behind them"
    ],
    "cameraAndTiming": "Low valley camera at ~[0,6,28] looking to -Z at sunset ridge. Slow 0.02 rad/s lateral drift plus subtle bob. 24s loop. Sky and hills stay framed; sun stays behind far ridge.",
    "controls": [
      {
        "effect": "Thickens or thins valley fog without rebaking sky",
        "name": "fogDensity"
      },
      {
        "effect": "Lowers last-light disc and warms direct light",
        "name": "sunsetFade"
      },
      {
        "effect": "Raises rolling hill amplitude",
        "name": "hillHeight"
      }
    ],
    "successCriteria": [
      "Layered hills fill lower two-thirds with nearer dark, farther paler",
      "Far ridge is fogged and low sun glow sits directly behind it",
      "Sky shows dusk gradient from warm horizon to dusky blue zenith",
      "Valley hollows show thicker fog than hilltops in one frame",
      "No black unlit regions or missing background pixels"
    ],
    "unresolved": [
      "Exact GradientSky sunCos for partly occluded disc tuned by eye, not in docs",
      "HeightFog sun irradiance coupling to TimeOfDay not used; fixed dusk value"
    ]
  },
  "program": {
    "controls": [
      {
        "default": "1.0",
        "id": "fogDensity",
        "max": 2,
        "min": 0.2,
        "target": "fog.setHeightFog scattering scale",
        "type": "float"
      },
      {
        "default": "0.6",
        "id": "sunsetFade",
        "max": 1,
        "min": 0,
        "target": "env.setSkyParams exposure + light intensity",
        "type": "float"
      },
      {
        "default": "1.0",
        "id": "hillHeight",
        "max": 1.8,
        "min": 0.4,
        "target": "terrain displacement amplitude (rebuild)",
        "type": "float"
      }
    ],
    "lifecycle": {
      "dispose": [
        "destroy lambert, lights, env, fog, geometry buffers"
      ],
      "fixedStep": [],
      "frame": [
        "update sun fade, lights.upload(), engine.render([scenePass, skyPass])"
      ],
      "init": [
        "init engine by host, build terrain, create passes, set sky, bake env, upload instances"
      ],
      "resize": [
        "resize scene and sky passes to canvas size"
      ]
    },
    "modules": [],
